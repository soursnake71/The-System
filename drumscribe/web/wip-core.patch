+// ------------------------------------------------------------------------------------------------ DrumSepDemix
+struct DrumSepDemix::Impl {
+    long L = 0, hop = 0, pad = 0, lead = 0, PL = 0, nchunks = 0;
+    int overlap = 1, nth = 1;
+    std::vector<float> mix[2];
+    std::vector<std::vector<float>> acc, ychunk;
+    std::vector<Stft> stft;
+};
+
+DrumSepDemix::DrumSepDemix(const Stereo& drums, int overlap) : d(std::make_unique<Impl>()) {
+    Impl& m = *d;
+    m.L = (long)drums.size();
+    const float* ch[2] = {drums.l.data(), drums.r.size() == drums.l.size() ? drums.r.data() : drums.l.data()};
+    // MDXCSeparator.demix: hop = chunk // overlap; zero padding chunk-hop in front, pad + chunk-hop behind
+    m.overlap = std::clamp(overlap, 1, kChunk);
+    m.hop = kChunk / m.overlap;
+    m.pad = m.hop - (((m.L - kChunk) % m.hop) + m.hop) % m.hop;  // python's modulo
+    m.lead = kChunk - m.hop;
+    m.PL = m.L + m.pad + 2 * m.lead;
+    for (int c = 0; c < 2; ++c) {
+        m.mix[c].assign(m.PL, 0.f);
+        if (m.L) std::copy(ch[c], ch[c] + m.L, m.mix[c].begin() + m.lead);
+    }
+    m.nchunks = m.L ? (m.PL - kChunk) / m.hop + 1 : 0;  // unfold(1, chunk, hop)
+    m.acc.assign(kNumStems * 2, std::vector<float>(m.PL, 0.f));
+#ifdef DS_SINGLE_THREAD
+    m.nth = 1;
+#else
+    m.nth = std::max(1, std::min(num_threads(), 2 * kNumStems));
+#endif
+    m.stft.resize(m.nth);
+    m.ychunk.assign(kNumStems * 2, std::vector<float>(kChunk));
+}
+
+DrumSepDemix::~DrumSepDemix() = default;
+
+long DrumSepDemix::chunks() const { return d->nchunks; }
+
+void DrumSepDemix::input(long k, float* spec) {
+    Impl& m = *d;
+    const long plane = (long)kDimF * kFrames, st = k * m.hop;
+    m.stft[0].forward(m.mix[0].data() + st, spec, spec + plane);
+    m.stft[0].forward(m.mix[1].data() + st, spec + 2 * plane, spec + 3 * plane);
+}
+
+void DrumSepDemix::add(long k, const float* o) {
+    Impl& m = *d;
+    const long plane = (long)kDimF * kFrames, st = k * m.hop;
+    // iSTFT of the 12 (stem, channel) spectrograms on worker threads
+    std::atomic<int> nx{0};
+    auto job = [&](int wi) {
+        std::vector<float> ola;
+        for (int j; (j = nx.fetch_add(1)) < kNumStems * 2;) {
+            const float* base = o + (long)j * 2 * plane;  // [stem][ch*2 + reim]
+            m.stft[wi].inverse(base, base + plane, m.ychunk[j].data(), ola);
+        }
+    };
+#ifdef DS_SINGLE_THREAD
+    job(0);
+#else
+    std::vector<std::thread> th;
+    for (int i = 1; i < m.nth; ++i) th.emplace_back(job, i);
+    job(0);
+    for (auto& t : th) t.join();
+#endif
+    for (int j = 0; j < kNumStems * 2; ++j) {
+        float* a = m.acc[j].data() + st;
+        const float* y = m.ychunk[j].data();
+        for (long i = 0; i < kChunk; ++i) a[i] += y[i];
+    }
+}
+
+std::vector<Stereo> DrumSepDemix::finish() {
+    Impl& m = *d;
+    std::vector<Stereo> res(kNumStems);
+    // accumulated / overlap, then [chunk - hop : -(pad + chunk - hop)]; each accumulator freed once copied (memory)
+    for (int s = 0; s < kNumStems; ++s)
+        for (int c = 0; c < 2; ++c) {
+            Signal& dst = c ? res[s].r : res[s].l;
+            auto& a = m.acc[s * 2 + c];
+            dst.resize(m.L);
+            for (long i = 0; i < m.L; ++i) dst[i] = a[m.lead + i] / (float)m.overlap;
+            std::vector<float>().swap(a);
+        }
+    for (auto& v : m.mix) std::vector<float>().swap(v);
+    return res;
+}
+
+float drumsep_input_gain(const Stereo& drums) {
+    float peak = 0;
+    for (float v : drums.l) peak = std::max(peak, std::fabs(v));
+    for (float v : drums.r) peak = std::max(peak, std::fabs(v));
+    return peak > 0 ? 0.5f / peak : 1.f;
+}
+
+std::map<std::string, Signal> drumsep_kit(std::vector<Stereo>& kit, float gain) {
+    std::map<std::string, Signal> out;
+    for (int s = 0; s < kNumStems; ++s) {
+        Signal m(kit[s].l.size());
+        for (size_t i = 0; i < m.size(); ++i) m[i] = 0.5f * (kit[s].l[i] + kit[s].r[i]) / gain;
+        out[kKitStems[s]] = std::move(m);
+        kit[s] = Stereo{};
+    }
+    return out;
+}
