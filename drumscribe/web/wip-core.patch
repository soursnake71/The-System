+// MDXCSeparator.demix step by step, whatever runs the net (ONNX Runtime in drumsep_run; onnxruntime-web in the
+// browser build): input(k) writes the net's input for chunk k (spec [1][4][1024][256]: ch0 re, ch0 im, ch1 re, ch1 im),
+// add(k, out) overlap-adds the net's output for it (out [1][6][4][1024][256]), finish() returns the stems.
+class DrumSepDemix {
+public:
+    static constexpr long kInputSize = 4L * 1024 * 256, kOutputSize = 6 * kInputSize;
+    DrumSepDemix(const Stereo& drums, int overlap);
+    ~DrumSepDemix();
+    long chunks() const;
+    void input(long k, float* spec);
+    void add(long k, const float* out);
+    std::vector<Stereo> finish();  // kKitStems order, stereo; frees the buffers
+private:
+    struct Impl;
+    std::unique_ptr<Impl> d;
+};
+// separate() runs DrumSep on the drum stem scaled to 0.5 peak (this gain), and turns its stereo output into the mono
+// kit pieces at the drum stem's level (drumsep_kit; frees `kit`)
+float drumsep_input_gain(const Stereo& drums);
+std::map<std::string, Signal> drumsep_kit(std::vector<Stereo>& kit, float gain);
+
 void release_models();  // drop the cached models / ONNX session (they're kept between separate() calls)
 
