<?xml version="1.0" encoding="utf-8"?>
<!-- Omega Seven: the web app is bundled in the APK (assets/seven) and runs in SevenActivity, offline. MIDI (USB and
     Bluetooth) and saving files are native here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-feature android:name="android.software.midi" android:required="false" />
  <application>
    <activity android:name="com.google.androidbrowserhelper.trusted.LauncherActivity" tools:node="remove" />
    <activity android:name=".TvActivity" tools:node="remove" />
    <activity android:name=".SevenActivity" android:exported="true" android:label="@string/app_name" android:banner="@drawable/banner"
      android:screenOrientation="sensorLandscape"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
      android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
      <!-- open .syx and .mid files from a file manager -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" android:mimeType="audio/midi" />
        <data android:scheme="content" android:mimeType="audio/x-midi" />
        <data android:scheme="content" android:mimeType="application/octet-stream" />
      </intent-filter>
    </activity>
  </application>
</manifest>
