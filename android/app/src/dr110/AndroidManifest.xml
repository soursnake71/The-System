<?xml version="1.0" encoding="utf-8"?>
<!-- Omega DR-110: the web app is bundled in the APK (assets/dr110) and runs in DR110Activity, offline,
     instead of the Trusted Web Activity that opens the website. MIDI and saving files are native here. Turns with the phone: portrait or landscape. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-feature android:name="android.software.midi" android:required="false" />
  <application>
    <activity android:name="com.google.androidbrowserhelper.trusted.LauncherActivity" tools:node="remove" />
    <activity android:name=".TvActivity" tools:node="remove" />
    <activity android:name=".DR110Activity" android:exported="true" android:label="@string/app_name" android:banner="@drawable/banner"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
      android:theme="@android:style/Theme.Material.NoActionBar" android:screenOrientation="fullSensor" android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
