<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/intro" android:textSize="15sp" android:textColor="#FFC8CCD4" />
    <Button android:id="@+id/choose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/choose" android:textSize="18sp" android:backgroundTint="@color/accent" android:textColor="#FFFFFFFF" />
    <Button android:id="@+id/choose_folder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/choose_folder" android:textSize="18sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/folder_hint" android:textSize="13sp" android:textColor="#FF8A909C" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/output" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/output" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" android:textColor="#FFC8CCD4" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <Button android:id="@+id/change_output" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/change_output" />
      <Button android:id="@+id/default_output" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/default_output" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/bitrate" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
    <RadioGroup android:id="@+id/bitrate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
      <RadioButton android:id="@+id/kbps_6000" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kbps_6000" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
      <RadioButton android:id="@+id/kbps_10000" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kbps_10000" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
      <RadioButton android:id="@+id/kbps_20000" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kbps_20000" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
      <RadioButton android:id="@+id/kbps_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kbps_0" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
    </RadioGroup>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/bitrate_hint" android:textSize="13sp" android:textColor="#FF8A909C" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/quality" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
    <RadioGroup android:id="@+id/quality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
      <RadioButton android:id="@+id/quality_fast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quality_fast" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
      <RadioButton android:id="@+id/quality_good" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quality_good" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
    </RadioGroup>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/quality_hint" android:textSize="13sp" android:textColor="#FF8A909C" />

    <CheckBox android:id="@+id/keep_subs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/keep_subs" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
    <CheckBox android:id="@+id/max_compat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/max_compat" android:textColor="#FFC8CCD4" android:buttonTint="@color/accent" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/idle" android:textSize="16sp" android:textColor="#FFFFFFFF" />
    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="1000" android:progressTint="@color/accent" android:visibility="gone" />
    <Button android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cancel" android:visibility="gone" />
    <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="14sp" android:textColor="#FFC8CCD4" android:textIsSelectable="true" />
  </LinearLayout>
</ScrollView>
