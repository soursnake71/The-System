# Copy to .env and fill in. Never commit .env.

# --- ElevenLabs (voice clone + conversational agent) ---
ELEVENLABS_API_KEY=
# Filled in by `npm run setup` (or paste existing ids):
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Optional: secret from ElevenLabs > Agents > Settings > Post-call webhook (HMAC)
ELEVENLABS_WEBHOOK_SECRET=

# --- Twilio (phone number that answers) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the calls land on, E.164
TWILIO_NUMBER=+15550000000

# --- People ---
# Your name as the caller knows you (the agent speaks as you)
MY_NAME=Chris
# What the caller calls you, if different ("son", "honey", a nickname)
CALLER_CALLS_ME=Chris
# Your real cell. Gets text summaries; emergencies are transferred here.
MY_CELL=+15551112222
# The caller's name and number(s), comma-separated, E.164
CALLER_NAME=Pat
CALLER_NUMBERS=+15553334444

# --- Behaviour ---
# ai   = the agent answers their calls
# ring = ring your real phone first, agent picks up if you don't answer in RING_SECONDS
# pass = always forward to your cell (agent off)
MODE=ai
RING_SECONDS=20
# Text you a summary after each call (true/false)
SMS_SUMMARIES=true
# Timezone for "earlier today" memory
TZ=America/New_York

# Public https URL of this server (ngrok, Render, Fly, etc.), no trailing slash
PUBLIC_URL=https://your-server.example.com
# Random string; needed to change MODE from your phone: /mode?key=...&set=ring
ADMIN_KEY=change-me
PORT=3000
